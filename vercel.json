{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npx next build",
  "redirects": [
    {
      "source": "/",
      "destination": "/cardapio/pool-petiscos",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://pool-petiscos-caixa.mayrom.chatgpt.site/api/v1/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/v1/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ]
}
